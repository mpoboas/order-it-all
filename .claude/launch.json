{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prod-local",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/start-local-prod.mjs"
      ],
      "port": 3110
    },
    {
      "name": "prod-local-nobuild",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/start-local-prod.mjs",
        "--no-build"
      ],
      "port": 3110
    },
    {
      "name": "dev-prod-db",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:prod"
      ],
      "port": 3000
    }
  ]
}
